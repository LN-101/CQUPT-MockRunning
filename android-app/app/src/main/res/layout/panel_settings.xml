<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/panelSettings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="92dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">
        <!-- ═══════════ 主题 ═══════════ -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="22dp"
            android:text="@string/l_theme" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/seg_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/segThemeAuto"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/seg_selected"
                android:gravity="center"
                android:text="@string/theme_auto_plain"
                android:textColor="@color/on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/segThemeDark"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/seg_normal"
                android:gravity="center"
                android:text="@string/theme_dark_plain"
                android:textColor="@color/fg_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/segThemeLight"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/seg_normal"
                android:gravity="center"
                android:text="@string/theme_light_plain"
                android:textColor="@color/fg_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ═══════════ 说明 ═══════════ -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="22dp"
            android:text="@string/about_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:lineSpacingExtra="6dp"
            android:padding="14dp"
            android:text="@string/about_body"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <!-- 开源仓库 -->
        <TextView
            android:id="@+id/tvRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/box"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="@string/repo_link"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnCopyRepo"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="@string/b_copy_repo"
            android:textColor="@color/fg_dim"
            android:textSize="14sp" />

        <!-- ═══════════ 署名 ═══════════ -->
        <TextView
            android:id="@+id/tvCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:lineSpacingExtra="4dp"
            android:text="@string/credit"
            android:textColor="@color/fg_dim"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
