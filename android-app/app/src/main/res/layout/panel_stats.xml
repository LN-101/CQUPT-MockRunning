<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/panelStats"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="92dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">
        <!-- ═══════════ 成绩统计 ═══════════ -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="22dp"
            android:text="@string/l_stats" />

        <Button
            android:id="@+id/btnRefreshStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_ghost"
            android:text="@string/b_refresh_stats"
            android:textAllCaps="false"
            android:textColor="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/box"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStatsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="@string/stats_hint"
                android:textColor="@color/fg"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginTop="14dp"
            android:text="@string/l_stats_place" />

        <TextView
            android:id="@+id/tvStatsByPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:lineSpacingExtra="5dp"
            android:padding="12dp"
            android:text="@string/stats_dash"
            android:textColor="@color/log"
            android:textSize="15sp" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="14dp"
            android:text="@string/l_stats_list" />

        <TextView
            android:id="@+id/tvStatsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="@string/stats_dash"
            android:textColor="@color/log"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
