<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/panelStart"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="92dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">
        <!-- ═══════════ 使用教程 ═══════════ -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="22dp"
            android:text="@string/tutorial_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:lineSpacingExtra="6dp"
            android:padding="14dp"
            android:text="@string/tutorial_body"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <!-- ═══════════ 账号 ═══════════ -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="4dp"
            android:text="@string/grp_account" />

        <EditText
            android:id="@+id/etOpenid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:hint="@string/h_openid"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost"
            android:text="@string/b_connect"
            android:textAllCaps="false"
            android:textColor="@color/accent" />

        <!-- openid 怎么拿：收进折叠区，不占主页 -->
        <Button
            android:id="@+id/btnToggleOpenidHelp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:text="@string/b_openid_help"
            android:textAllCaps="false"
            android:textColor="@color/fg_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/panelOpenidHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/box"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="@string/help_body"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyScript"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_solid"
                    android:text="@string/b_copy_script"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShareScript"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="@string/b_share_script"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleScript"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/b_view_script"
                android:textAllCaps="false"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

            <ScrollView
                android:id="@+id/scriptScroll"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/box"
                android:fillViewport="true"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/log"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>

            <TextView
                android:id="@+id/tvScriptPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
