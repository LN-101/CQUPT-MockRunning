<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：共享顶栏 + 四页内容 + 悬浮切换栏。

  四页是同一 Activity 里的四个 panel（不引 Fragment / 导航库，守住「零第三方依赖」）：
      主页  打卡参数与仪表盘
      统计  成绩表
      上手  使用教程 / openid / 取码
      设置  主题 / 说明 / 开源仓库 / 署名

  悬浮栏放在 FrameLayout 里（layout_gravity=bottom），所以它是真的浮在内容之上；
  每个 panel 的 ScrollView 都留了 92dp 底边距，内容不会被盖住。

  跑步线程归 RunController 单例所有，切页只是切可见性，不影响正在跑的打卡。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ═══════════ 共享顶栏：四页都一样，切换时不动 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/app_title"
                    android:textColor="@color/accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.3"
                    android:text="@string/app_tag"
                    android:textColor="@color/fg_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:text="@string/app_sub"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 日志：完整运行日志在【日志】页看，主页只给最后一行摘要 -->
        <ImageButton
            android:id="@+id/btnLog"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/log_page"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_log"
            app:tint="@color/fg" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/panel_run" />

        <include
            layout="@layout/panel_stats" />

        <include
            layout="@layout/panel_start" />

        <include
            layout="@layout/panel_settings" />

        <!-- ═══════════ 悬浮切换栏 ═══════════ -->
        <!--
          半透明卡片，浮在内容之上。试过真模糊（截背后那一条 + 采样放大 + 盒式模糊），
          效果和代价都不划算，砍掉了 —— 85% 不透明已经够轻，也不会糊得看不清字。
        -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/nav_bar"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tabRun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_selected"
                android:gravity="center"
                android:text="@string/nav_run"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_normal"
                android:gravity="center"
                android:text="@string/nav_stats"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabStart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_normal"
                android:gravity="center"
                android:text="@string/nav_start"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_normal"
                android:gravity="center"
                android:text="@string/nav_settings"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
