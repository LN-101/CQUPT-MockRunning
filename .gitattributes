# 统一行尾，避免 Windows / Linux 之间 diff 出一堆假改动
* text=auto eol=lf

# gradlew 是 shell 脚本，必须是 LF —— CRLF 会让 Linux 报 bad interpreter
gradlew  text eol=lf
*.sh     text eol=lf

# gradlew.bat 是批处理，必须是 CRLF
gradlew.bat  text eol=crlf
*.bat        text eol=crlf

# 二进制：别做任何行尾转换
*.png      binary
*.jpg      binary
*.jpeg     binary
*.jar      binary
*.apk      binary
*.keystore binary
*.jks      binary
